 "podman-lane.yml": {
  "concurrency": {
   "cancel-in-progress": "${{ github.event_name == 'pull_request' }}",
   "group": "podman-lane-${{ github.event_name }}-${{ github.ref }}"
  },
  "jobs": {
   "cancel-others": {
    "if": "${{ failure() && github.event_name == 'pull_request' }}",
    "needs": "podman-majors",
    "permissions": {
     "actions": "write",
     "contents": "read"
    },
    "steps": [],
    "uses": "./.github/workflows/reusable-cancel-others.yml"
   },
   "decide": {
    "name": "Decide whether the VM has anything to look at",
    "outputs": {
     "engine": "${{ steps.files.outputs.engine }}"
    },
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "sha": "753e982e1c332bfd",
      "uses": "actions/checkout@<commit>"
     },
     {
      "name": "List the changed files against the base",
      "sha": "eb10bb057d6a1cc4",
      "uses": null
     }
    ],
    "timeout-minutes": 10
   },
   "podman-majors": {
    "if": "always()",
    "name": "Supported Podman majors${{ github.event_name == 'pull_request' && github.base_ref == 'main' && ' (promotion)' || !(github.event_name == 'merge_group' || github.event_name == 'pull_request' && github.base_ref == 'develop') && format(' ({0})', github.event_name) || '' }}",
    "needs": [
     "decide",
     "podman-vm",
     "podman-native"
    ],
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "name": "Reflect the matrix result",
      "sha": "ab99176dc793831b",
      "uses": null
     }
    ],
    "timeout-minutes": 10
   },
   "podman-native": {
    "env": {
     "GLYNDOR_APT_FPR": "9ADF04EA8C3139CDB67303CFA6705C2EA153F3D6",
     "PODMAN_FLOOR": "6.2.0"
    },
    "if": "${{ !cancelled() && (github.event_name == 'pull_request' || github.event_name == 'merge_group') && needs.decide.outputs.engine != 'false' }}",
    "needs": "decide",
    "permissions": {
     "contents": "read"
    },
    "runs-on": "ubuntu-24.04",
    "steps": [
     {},
     {
      "name": "Install Podman from the Glyndor apt repository",
      "timeout-minutes": 25
     },
     {
      "name": "Install the Rust toolchain"
     },
     {
      "name": "Build the engine test binaries"
     },
     {
      "name": "Start the user Podman socket"
     },
     {
      "name": "Run the engine suite and the leak scan"
     },
     {
      "if": "${{ !cancelled() && steps.install.outcome == 'success' }}",
      "name": "Run the Quadlet tests against the generator of this Podman"
     },
     {
      "if": "always()",
      "name": "Show what AppArmor refused"
     },
     {
      "if": "always()",
      "name": "Report the phases"
     }
    ],
    "timeout-minutes": 60
   },
   "podman-vm": {
    "if": "${{ !cancelled() && github.event_name != 'pull_request' && github.event_name != 'merge_group' }}",
    "name": "podman-vm (${{ matrix.podman }}${{ matrix.mode == 'coverage' && ', coverage' || '' }})",
    "needs": "decide",
    "runs-on": "ubuntu-24.04",
    "steps": [
     {},
     {
      "if": "needs.decide.outputs.engine == 'false'",
      "name": "Nothing to boot"
     },
     {
      "if": "needs.decide.outputs.engine != 'false'",
      "name": "Install qemu + cloud tools",
      "timeout-minutes": 18
     },
     {
      "if": "needs.decide.outputs.engine != 'false'",
      "name": "Fetch Fedora cloud image (Podman 6 = rawhide)"
     },
     {
      "if": "needs.decide.outputs.engine != 'false'",
      "name": "Build cloud-init seed"
     },
     {
      "if": "needs.decide.outputs.engine != 'false'",
      "name": "Copy the judge out of the workspace"
     },
     {
      "if": "needs.decide.outputs.engine != 'false'",
      "name": "Boot VM (9p = repo only) + capture"
     },
     {
      "if": "needs.decide.outputs.engine != 'false'",
      "name": "Verify the VM"
     }
    ],
    "strategy": {
     "fail-fast": false,
     "matrix": {
      "include": [
       {
        "job_minutes": 100,
        "mode": "suite",
        "vm_seconds": 4500
       },
       {
        "job_minutes": 129,
        "mode": "coverage",
        "vm_seconds": 6240
       }
      ],
      "mode": [
       "suite",
       "coverage"
      ],
      "podman": [
       "6"
      ]
     }
    },
    "timeout-minutes": "${{ matrix.job_minutes }}"
   }
  },
  "name": "podman-lane",
  "permissions": {
   "contents": "read"
  },
  "true": {
   "merge_group": {
    "types": [
     "checks_requested"
    ]
   },
   "pull_request": {
    "branches": [
     "main",
     "develop"
    ],
    "types": [
     "opened",
     "synchronize"
    ]
   },
   "schedule": [
    {
     "cron": "0 9 * * *"
    }
   ],
   "workflow_dispatch": null
  }
 },

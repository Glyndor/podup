 "podman-lane.yml": {
  "env": null,
  "jobs": {
   "cancel-others": {
    "if": "${{ failure() && github.event_name == 'pull_request' }}",
    "needs": "podman-majors",
    "permissions": {
     "actions": "write",
     "contents": "read"
    },
    "uses": "./.github/workflows/reusable-cancel-others.yml"
   },
   "decide": {
    "name": "Decide whether the VM has anything to look at",
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "name": null,
      "sha": "3facce523aa8a0e2"
     },
     {
      "name": "List the changed files against the base",
      "sha": "c0e72debd43d9c37"
     }
    ]
   },
   "podman-majors": {
    "if": "always()",
    "name": "Supported Podman majors${{ github.event_name == 'pull_request' && github.base_ref == 'main' && ' (promotion)' || github.event_name != 'pull_request' && github.event_name != 'merge_group' && format(' ({0})', github.event_name) || '' }}",
    "needs": [
     "decide",
     "podman-vm"
    ],
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "name": "Reflect the matrix result",
      "sha": "592dce7e8361a23e"
     }
    ]
   },
   "podman-vm": {
    "if": "${{ !cancelled() }}",
    "needs": "decide",
    "runs-on": "ubuntu-24.04",
    "steps": [
     {
      "if": null,
      "name": null
     },
     {
      "if": "needs.decide.outputs.engine == 'false'",
      "name": "Nothing to boot"
     },
     {
      "if": "needs.decide.outputs.engine != 'false'",
      "name": "Install qemu + cloud tools"
     },
     {
      "if": "needs.decide.outputs.engine != 'false'",
      "name": "Fetch Fedora cloud image (Podman 6 = rawhide)"
     },
     {
      "if": "needs.decide.outputs.engine != 'false'",
      "name": "Build cloud-init seed (script-file for clean RC)"
     },
     {
      "if": "needs.decide.outputs.engine != 'false'",
      "name": "Boot VM (9p = repo only) + capture"
     },
     {
      "if": "needs.decide.outputs.engine != 'false'",
      "name": "Verify podup core suite passed on the target Podman"
     }
    ],
    "strategy": {
     "fail-fast": false,
     "matrix": {
      "podman": [
       "6"
      ]
     }
    }
   }
  },
  "on": {
   "merge_group": {
    "types": [
     "checks_requested"
    ]
   },
   "pull_request": null,
   "schedule": [
    {
     "cron": "0 9 * * *"
    }
   ],
   "workflow_dispatch": null
  },
  "permissions": {
   "contents": "read"
  }
 },

{
 "audit.yml": {
  "concurrency": {
   "cancel-in-progress": false,
   "group": "${{ github.workflow }}-${{ github.run_id }}"
  },
  "jobs": {
   "audit": {
    "steps": [],
    "uses": "./.github/workflows/reusable-rust-audit.yml"
   },
   "audit-develop": {
    "env": {
     "GH_REPO": "${{ github.repository }}",
     "GH_TOKEN": "${{ github.token }}"
    },
    "if": "github.event_name == 'schedule'",
    "name": "start the develop audit",
    "permissions": {
     "actions": "write"
    },
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "name": "Dispatch audit.yml on develop and wait for it",
      "sha": "27fe53f615eac159",
      "uses": null
     }
    ],
    "timeout-minutes": 150
   },
   "report": {
    "env": {
     "AUDIT_RESULT": "${{ needs.audit.result }}",
     "DISPATCH_RESULT": "${{ needs.audit-develop.result }}",
     "GH_REPO": "${{ github.repository }}",
     "GH_TOKEN": "${{ github.token }}",
     "ISSUE_TITLE": "Scheduled dependency audit failed",
     "REF_NAME": "${{ github.ref_name }}",
     "RUN_URL": "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"
    },
    "if": "always() && ((github.event_name == 'schedule' && (needs.audit.result != 'success' || needs.audit-develop.result != 'success')) || (github.event_name == 'workflow_dispatch' && !inputs.parent-run && needs.audit.result != 'success'))",
    "name": "open an issue when the scheduled audit fails",
    "needs": [
     "audit",
     "audit-develop"
    ],
    "permissions": {
     "issues": "write"
    },
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "name": "Open a single tracking issue and update it on each failure",
      "sha": "92958f7ad35add9e",
      "uses": null
     }
    ],
    "timeout-minutes": 10
   }
  },
  "name": "Security audit",
  "permissions": {
   "contents": "read"
  },
  "run-name": "${{ inputs.parent-run && format('Security audit of develop for run {0}', inputs.parent-run) || github.workflow }}",
  "true": {
   "merge_group": {
    "types": [
     "checks_requested"
    ]
   },
   "pull_request": {
    "branches": [
     "main",
     "develop"
    ],
    "types": [
     "opened",
     "synchronize"
    ]
   },
   "schedule": [
    {
     "cron": "0 6 * * *"
    }
   ],
   "workflow_dispatch": {
    "inputs": {
     "parent-run": {
      "default": "",
      "description": "Set by the scheduled run on main to its own run id when it starts the develop audit; empty for a manual dispatch",
      "type": "string"
     }
    }
   }
  }
 },
 "ci.yml": {
  "concurrency": {
   "cancel-in-progress": "${{ github.event_name == 'pull_request' }}",
   "group": "${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.ref || github.run_id }}"
  },
  "jobs": {
   "cancel-others": {
    "if": "${{ failure() && github.event_name == 'pull_request' }}",
    "needs": "rust",
    "permissions": {
     "actions": "write",
     "contents": "read"
    },
    "steps": [],
    "uses": "./.github/workflows/reusable-cancel-others.yml"
   },
   "deprecations": {
    "if": "always()",
    "needs": "rust",
    "permissions": {
     "actions": "read",
     "checks": "read",
     "contents": "read"
    },
    "steps": [],
    "uses": "./.github/workflows/reusable-deprecation-notices.yml"
   },
   "rust": {
    "steps": [],
    "uses": "./.github/workflows/reusable-rust-ci.yml",
    "with": {
     "coverage-threshold": 76,
     "doc-warnings": true,
     "extra-clippy-args": "--no-default-features --features watch,completions",
     "extra-test-os": "[\"macos-latest\", \"windows-latest\"]",
     "msrv": "1.91",
     "package-check": false,
     "semver-check": false
    }
   },
   "stop-on-failure": {
    "permissions": {
     "actions": "write",
     "checks": "read",
     "contents": "read"
    },
    "steps": [],
    "uses": "./.github/workflows/reusable-stop-on-failure.yml"
   }
  },
  "name": "CI",
  "permissions": {
   "contents": "read"
  },
  "true": {
   "merge_group": {
    "types": [
     "checks_requested"
    ]
   },
   "pull_request": {
    "branches": [
     "main",
     "develop"
    ],
    "types": [
     "opened",
     "synchronize"
    ]
   },
   "push": {
    "branches": [
     "main"
    ]
   }
  }
 },
 "commit-hygiene.yml": {
  "concurrency": {
   "cancel-in-progress": false,
   "group": "${{ github.workflow }}-${{ github.run_id }}"
  },
  "jobs": {
   "cancel-others": {
    "if": "${{ failure() && github.event_name == 'pull_request' }}",
    "needs": [
     "commit-identity",
     "secret-scan",
     "pin-values"
    ],
    "permissions": {
     "actions": "write",
     "contents": "read"
    },
    "steps": [],
    "uses": "./.github/workflows/reusable-cancel-others.yml"
   },
   "commit-identity": {
    "name": "commit identity${{ github.event_name == 'pull_request' && github.base_ref == 'main' && ' (promotion)' || !(github.event_name == 'merge_group' || github.event_name == 'pull_request' && github.base_ref == 'develop') && format(' ({0})', github.event_name) || '' }}",
    "permissions": {
     "contents": "read"
    },
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "sha": "3454c500a3dbc3ff",
      "uses": "actions/checkout@<commit>"
     },
     {
      "name": "Take the check from the base commit",
      "sha": "c14703ae13b99332",
      "uses": null
     },
     {
      "name": "Every commit uses a GitHub noreply address",
      "sha": "66250331c3bb0c17",
      "uses": null
     }
    ],
    "timeout-minutes": 5
   },
   "pin-values": {
    "env": {
     "BASE": "${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha }}",
     "HEAD": "${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha }}"
    },
    "name": "pin values${{ github.event_name == 'pull_request' && github.base_ref == 'main' && ' (promotion)' || !(github.event_name == 'merge_group' || github.event_name == 'pull_request' && github.base_ref == 'develop') && format(' ({0})', github.event_name) || '' }}",
    "permissions": {
     "contents": "read"
    },
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "sha": "d47e05bc7dd10448",
      "uses": "actions/checkout@<commit>"
     },
     {
      "sha": "2c2cfb428f4fb43a",
      "uses": "actions/checkout@<commit>"
     },
     {
      "name": "Take the judge from the base commit",
      "sha": "65b4bd3420587ac0",
      "uses": null
     },
     {
      "name": "Every pin is the commit of its tag",
      "sha": "e2da0f34d605fa6c",
      "uses": null,
      "working-directory": "${{ runner.temp }}"
     }
    ],
    "timeout-minutes": 10
   },
   "secret-scan": {
    "name": "secret scan${{ github.event_name == 'pull_request' && github.base_ref == 'main' && ' (promotion)' || !(github.event_name == 'merge_group' || github.event_name == 'pull_request' && github.base_ref == 'develop') && format(' ({0})', github.event_name) || '' }}",
    "permissions": {
     "contents": "read"
    },
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "sha": "3454c500a3dbc3ff",
      "uses": "actions/checkout@<commit>"
     },
     {
      "name": "Take the check from the base commit",
      "sha": "50d2ababa4217153",
      "uses": null
     },
     {
      "name": "The change adds no credential-shaped line",
      "sha": "77d26d2406ce4023",
      "uses": null
     }
    ],
    "timeout-minutes": 5
   }
  },
  "name": "commit hygiene",
  "permissions": {},
  "true": {
   "merge_group": {
    "types": [
     "checks_requested"
    ]
   },
   "pull_request": {
    "branches": [
     "main",
     "develop"
    ],
    "types": [
     "opened",
     "synchronize"
    ]
   }
  }
 },

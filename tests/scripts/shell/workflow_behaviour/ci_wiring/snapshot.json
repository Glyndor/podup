{
 "ci.yml": {
  "env": null,
  "jobs": {
   "cancel-others": {
    "if": "${{ failure() && github.event_name == 'pull_request' }}",
    "needs": "rust",
    "permissions": {
     "actions": "write",
     "contents": "read"
    },
    "uses": "./.github/workflows/reusable-cancel-others.yml"
   },
   "rust": {
    "uses": "./.github/workflows/reusable-rust-ci.yml",
    "with": {
     "coverage-threshold": 76,
     "doc-warnings": true,
     "extra-clippy-args": "--no-default-features --features watch,completions",
     "extra-test-os": "[\"macos-latest\", \"windows-latest\"]",
     "msrv": "1.88",
     "package-check": false,
     "semver-check": false
    }
   }
  },
  "on": {
   "merge_group": {
    "types": [
     "checks_requested"
    ]
   },
   "pull_request": {
    "branches": [
     "main",
     "develop"
    ]
   },
   "push": {
    "branches": [
     "main",
     "develop"
    ]
   }
  },
  "permissions": {
   "contents": "read"
  }
 },
 "commit-hygiene.yml": {
  "env": null,
  "jobs": {
   "cancel-others": {
    "if": "${{ failure() && github.event_name == 'pull_request' }}",
    "needs": [
     "commit-identity",
     "secret-scan"
    ],
    "permissions": {
     "actions": "write",
     "contents": "read"
    },
    "uses": "./.github/workflows/reusable-cancel-others.yml"
   },
   "commit-identity": {
    "name": "commit identity",
    "permissions": {
     "contents": "read"
    },
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "name": null,
      "sha": "22f655d0e8a7080a"
     },
     {
      "name": "Every commit uses a GitHub noreply address",
      "sha": "5ebd16b01a3448d4"
     }
    ]
   },
   "secret-scan": {
    "name": "secret scan",
    "permissions": {
     "contents": "read"
    },
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "name": null,
      "sha": "22f655d0e8a7080a"
     },
     {
      "name": "The change adds no credential-shaped line",
      "sha": "65ea5b9e30fb3324"
     }
    ]
   }
  },
  "on": {
   "pull_request": {
    "branches": [
     "main",
     "develop"
    ]
   }
  },
  "permissions": {}
 },

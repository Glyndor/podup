 "reusable-stop-on-failure.yml": {
  "jobs": {
   "watch": {
    "if": "${{ github.event_name == 'pull_request' || github.event_name == 'merge_group' }}",
    "name": "stop at the first failure",
    "permissions": {
     "actions": "write",
     "checks": "read",
     "contents": "read"
    },
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "sha": "6661403ee47251dc",
      "uses": "actions/checkout@<commit>"
     },
     {
      "name": "Watch the check runs of the commit and cut the rest at the first failure",
      "sha": "09e2a4a9348de6c0",
      "uses": null
     }
    ],
    "timeout-minutes": 125
   }
  },
  "name": "Stop the runs of a commit at its first failure (reusable)",
  "permissions": {},
  "true": {
   "workflow_call": null
  }
 },
 "workflow-lint.yml": {
  "concurrency": {
   "cancel-in-progress": "${{ github.event_name == 'pull_request' }}",
   "group": "${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.ref || github.run_id }}"
  },
  "jobs": {
   "cancel-others": {
    "if": "${{ failure() && github.event_name == 'pull_request' }}",
    "needs": "workflow-lint",
    "permissions": {
     "actions": "write",
     "contents": "read"
    },
    "steps": [],
    "uses": "./.github/workflows/reusable-cancel-others.yml"
   },
   "workflow-lint": {
    "steps": [],
    "uses": "./.github/workflows/reusable-workflow-lint.yml"
   }
  },
  "name": "Workflow lint",
  "permissions": {
   "contents": "read"
  },
  "true": {
   "merge_group": {
    "types": [
     "checks_requested"
    ]
   },
   "pull_request": {
    "branches": [
     "main",
     "develop"
    ],
    "types": [
     "opened",
     "synchronize"
    ]
   },
   "push": {
    "branches": [
     "main"
    ]
   }
  }
 }

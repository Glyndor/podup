 "reusable-line-limit.yml": {
  "env": null,
  "jobs": {
   "line-limit": {
    "name": "line limit${{ github.event_name == 'pull_request' && github.base_ref == 'main' && ' (promotion)' || github.event_name != 'pull_request' && github.event_name != 'merge_group' && format(' ({0})', github.event_name) || '' }}",
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "name": null,
      "sha": "69983d424f70d56e"
     },
     {
      "name": "Check file lengths",
      "sha": "b00249359f27ebd2"
     }
    ]
   }
  },
  "on": {
   "workflow_call": {
    "inputs": {
     "exclude-pattern": {
      "default": "^bench/scenarios/",
      "description": "Optional extended regex; matching paths are skipped",
      "type": "string"
     },
     "extensions": {
      "default": "rs go ts tsx js jsx mjs cjs py sh astro vue svelte yml yaml",
      "description": "Space-separated source file extensions to check",
      "type": "string"
     },
     "hard-limit": {
      "default": 500,
      "description": "Files with more lines than this fail the build",
      "type": "number"
     },
     "soft-limit": {
      "default": 300,
      "description": "Files with more lines than this emit a warning",
      "type": "number"
     }
    }
   }
  },
  "permissions": {
   "contents": "read"
  }
 },

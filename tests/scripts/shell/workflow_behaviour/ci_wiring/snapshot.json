 "reusable-rust-ci.yml": {
  "concurrency": {
   "cancel-in-progress": "${{ github.event_name == 'pull_request' }}",
   "group": "rust-ci-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.ref || github.run_id }}-${{ inputs.working-directory }}"
  },
  "env": {
   "BASE_REF": "${{ github.event.pull_request.base.ref }}",
   "BASE_SHA": "${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || github.event.before }}",
   "CARGO_INCREMENTAL": "0",
   "CARGO_PROFILE_DEV_DEBUG": "line-tables-only",
   "EVENT": "${{ github.event_name }}",
   "HEAD_SHA": "${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}"
  },
  "jobs": {
   "classify": {
    "name": "Classify the range",
    "outputs": {
     "build": "${{ steps.build.outputs.build }}",
     "ci_only": "${{ steps.decide.outputs.ci_only }}",
     "docs_only": "${{ steps.decide.outputs.docs_only }}",
     "run": "${{ steps.decide.outputs.run }}"
    },
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "sha": "753e982e1c332bfd",
      "uses": "actions/checkout@<commit>"
     },
     {
      "name": "Decide whether the Rust lanes must run",
      "sha": "df7231b0dadcbf68",
      "uses": null
     },
     {
      "name": "Decide whether the root build inputs changed",
      "sha": "62d358a5610c5b3d",
      "uses": null
     }
    ],
    "timeout-minutes": 10
   },
   "coverage": {
    "defaults": {
     "run": {
      "working-directory": "${{ inputs.working-directory }}"
     }
    },
    "if": "${{ inputs.coverage-threshold > 0 && !cancelled() && (github.event_name != 'pull_request' || (needs.lint.result != 'failure' && needs.test.result != 'failure')) && (needs.classify.result != 'success' || needs.classify.outputs.run != 'false') && !(needs.classify.result == 'success' && needs.classify.outputs.run == 'true' && (needs.classify.outputs.docs_only == 'true' || needs.classify.outputs.ci_only == 'true')) }}",
    "name": "Coverage",
    "needs": [
     "classify",
     "lint",
     "test"
    ],
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "sha": "3939c41a8960de90",
      "uses": "actions/checkout@<commit>"
     },
     {
      "name": "Install toolchain",
      "sha": "717948cfb523641b",
      "uses": null
     },
     {
      "sha": "b02c501fa795a627",
      "uses": "actions/cache@<commit>"
     },
     {
      "name": "Install cargo-llvm-cov",
      "sha": "42756c2ee576405b",
      "uses": null
     },
     {
      "if": "inputs.podman",
      "name": "Start Podman socket",
      "sha": "5c086abe3ed31d6e",
      "uses": null
     },
     {
      "name": "Coverage gate",
      "sha": "9d81d983c8e6bd65",
      "uses": null
     }
    ],
    "timeout-minutes": 30
   },
   "doc": {
    "defaults": {
     "run": {
      "working-directory": "${{ inputs.working-directory }}"
     }
    },
    "if": "${{ !cancelled() && inputs.doc-warnings && (github.event_name != 'pull_request' || needs.lint.result != 'failure') && (needs.classify.result != 'success' || needs.classify.outputs.build != 'false') }}",
    "name": "Doc warnings",
    "needs": [
     "classify",
     "lint"
    ],
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "sha": "3939c41a8960de90",
      "uses": "actions/checkout@<commit>"
     },
     {
      "name": "Install toolchain",
      "sha": "ce42d5805d8f88ba",
      "uses": null
     },
     {
      "sha": "68e10bd5c2b0debe",
      "uses": "actions/cache@<commit>"
     },
     {
      "name": "Build docs with warnings denied",
      "sha": "7ddffeb879704f5a",
      "uses": null
     }
    ],
    "timeout-minutes": 10
   },
   "gate": {
    "if": "always()",
    "name": "Gate${{ github.event_name == 'pull_request' && github.base_ref == 'main' && ' (promotion)' || !(github.event_name == 'merge_group' || github.event_name == 'pull_request' && github.base_ref == 'develop') && format(' ({0})', github.event_name) || '' }}",
    "needs": [
     "classify",
     "lint",
     "test",
     "test-extra",
     "coverage",
     "msrv",
     "doc",
     "package",
     "semver"
    ],
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "name": "Certify the plan and every skip",
      "sha": "b55bf627dcb8fccf",
      "uses": null
     }
    ],
    "timeout-minutes": 10
   },
   "lint": {
    "defaults": {
     "run": {
      "working-directory": "${{ inputs.working-directory }}"
     }
    },
    "if": "${{ !cancelled() }}",
    "name": "Format & lint",
    "needs": "classify",
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "sha": "3939c41a8960de90",
      "uses": "actions/checkout@<commit>"
     },
     {
      "if": "needs.classify.outputs.run != 'false' && !(needs.classify.outputs.run == 'true' && (needs.classify.outputs.docs_only == 'true' || needs.classify.outputs.ci_only == 'true'))",
      "name": "Install toolchain",
      "sha": "1f70cf4057a9b38c",
      "uses": null
     },
     {
      "if": "needs.classify.outputs.run != 'false' && !(needs.classify.outputs.run == 'true' && (needs.classify.outputs.docs_only == 'true' || needs.classify.outputs.ci_only == 'true'))",
      "sha": "4e58b8e5cafb9102",
      "uses": "actions/cache@<commit>"
     },
     {
      "if": "needs.classify.outputs.run != 'false' && !(needs.classify.outputs.run == 'true' && (needs.classify.outputs.docs_only == 'true' || needs.classify.outputs.ci_only == 'true'))",
      "name": "rustfmt",
      "sha": "2ae32fed31813d96",
      "uses": null
     },
     {
      "if": "needs.classify.outputs.run != 'false' && !(needs.classify.outputs.run == 'true' && (needs.classify.outputs.docs_only == 'true' || needs.classify.outputs.ci_only == 'true'))",
      "name": "clippy",
      "sha": "bab1d5d5bc65b454",
      "uses": null
     },
     {
      "name": "no planning-note references",
      "sha": "f653b5b91c9f845c",
      "uses": null,
      "working-directory": "."
     },
     {
      "name": "no vetoed vocabulary",
      "sha": "0c60e640fe378b64",
      "uses": null,
      "working-directory": "."
     },
     {
      "name": "no private document references",
      "sha": "bb507524ab8bfa4e",
      "uses": null,
      "working-directory": "."
     },
     {
      "name": "folders hold at most twenty files",
      "sha": "692fabc0038f29eb",
      "uses": null,
      "working-directory": "."
     }
    ],
    "timeout-minutes": 10
   },
   "msrv": {
    "defaults": {
     "run": {
      "working-directory": "${{ inputs.working-directory }}"
     }
    },
    "if": "${{ !cancelled() && inputs.msrv != '' && (github.event_name != 'pull_request' || needs.lint.result != 'failure') && (needs.classify.result != 'success' || needs.classify.outputs.build != 'false') }}",
    "name": "MSRV (${{ inputs.msrv }})",
    "needs": [
     "classify",
     "lint"
    ],
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "sha": "3939c41a8960de90",
      "uses": "actions/checkout@<commit>"
     },
     {
      "name": "Install MSRV toolchain",
      "sha": "d0854b8c8def48f4",
      "uses": null
     },
     {
      "sha": "8b02d9782d90ee59",
      "uses": "actions/cache@<commit>"
     },
     {
      "name": "Build on the declared MSRV",
      "sha": "e0865c65da90b82f",
      "uses": null
     }
    ],
    "timeout-minutes": 15
   },
   "package": {
    "defaults": {
     "run": {
      "working-directory": "${{ inputs.working-directory }}"
     }
    },
    "if": "inputs.package-check",
    "name": "Package check",
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "sha": "3939c41a8960de90",
      "uses": "actions/checkout@<commit>"
     },
     {
      "name": "Install toolchain",
      "sha": "ce42d5805d8f88ba",
      "uses": null
     },
     {
      "name": "cargo publish --dry-run",
      "sha": "28b2fb7610d3e7b2",
      "uses": null
     }
    ],
    "timeout-minutes": 20
   },
   "semver": {
    "defaults": {
     "run": {
      "working-directory": "${{ inputs.working-directory }}"
     }
    },
    "if": "inputs.semver-check",
    "name": "Semver checks",
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "sha": "3939c41a8960de90",
      "uses": "actions/checkout@<commit>"
     },
     {
      "name": "Install toolchain",
      "sha": "ce42d5805d8f88ba",
      "uses": null
     },
     {
      "name": "Install cargo-semver-checks",
      "sha": "3ba576693b67f485",
      "uses": null
     },
     {
      "name": "Check for public API breaks",
      "sha": "d48751c4c3c59f93",
      "uses": null
     }
    ],
    "timeout-minutes": 20
   },
   "test": {
    "defaults": {
     "run": {
      "working-directory": "${{ inputs.working-directory }}"
     }
    },
    "if": "${{ !cancelled() && (github.event_name != 'pull_request' || needs.lint.result != 'failure') && (needs.classify.result != 'success' || needs.classify.outputs.run != 'false') }}",
    "name": "Test",
    "needs": [
     "classify",
     "lint"
    ],
    "runs-on": "ubuntu-latest",
    "steps": [
     {
      "sha": "3939c41a8960de90",
      "uses": "actions/checkout@<commit>"
     },
     {
      "name": "Install toolchain",
      "sha": "ce42d5805d8f88ba",
      "uses": null
     },
     {
      "sha": "dd45e120d31d35d1",
      "uses": "actions/cache@<commit>"
     },
     {
      "if": "${{ !(needs.classify.result == 'success' && needs.classify.outputs.run == 'true' && needs.classify.outputs.docs_only == 'true') }}",
      "name": "Tests",
      "sha": "b59f5cea6bb5177f",
      "uses": null
     },
     {
      "if": "needs.classify.result == 'success' && needs.classify.outputs.run == 'true' && needs.classify.outputs.docs_only == 'true'",
      "name": "Documentation tests",
      "sha": "84c79d0256dca870",
      "uses": null
     }
    ],
    "timeout-minutes": 20
   },
   "test-extra": {
    "defaults": {
     "run": {
      "shell": "bash",
      "working-directory": "${{ inputs.working-directory }}"
     }
    },
    "if": "${{ inputs.extra-test-os != '[]' && !cancelled() && (github.event_name != 'pull_request' || (needs.lint.result != 'failure' && needs.test.result != 'failure')) && (needs.classify.result != 'success' || needs.classify.outputs.run != 'false') && !(needs.classify.result == 'success' && needs.classify.outputs.run == 'true' && (needs.classify.outputs.docs_only == 'true' || needs.classify.outputs.ci_only == 'true')) }}",
    "name": "Test (${{ matrix.os }})",
    "needs": [
     "classify",
     "lint",
     "test"
    ],
    "runs-on": "${{ matrix.os }}",
    "steps": [
     {
      "sha": "3939c41a8960de90",
      "uses": "actions/checkout@<commit>"
     },
     {
      "name": "Install toolchain",
      "sha": "ce42d5805d8f88ba",
      "uses": null
     },
     {
      "sha": "dd45e120d31d35d1",
      "uses": "actions/cache@<commit>"
     },
     {
      "name": "Tests",
      "sha": "fb8c3e3e083446f1",
      "uses": null
     }
    ],
    "strategy": {
     "fail-fast": true,
     "matrix": {
      "os": "${{ fromJSON(inputs.extra-test-os) }}"
     }
    },
    "timeout-minutes": 35
   }
  },
  "name": "Rust CI (reusable)",
  "permissions": {
   "contents": "read"
  },
  "true": {
   "workflow_call": {
    "inputs": {
     "coverage-ignore-regex": {
      "default": "",

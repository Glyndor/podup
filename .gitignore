# Local working notes
GAP_ANALYSIS.md

# Coverage & profiling (root-level artifacts only; anchored so they don't
# swallow source dirs such as tests/compose/parsing/parse/coverage/)
*.profraw
*.profdata
/tarpaulin-report.html
/coverage/
/coverage-html*/
/coverage.json
/lcov.info

# Fuzzing
fuzz/corpus/
fuzz/artifacts/

# Merge conflicts
*.orig

# Build artifacts
/target
__pycache__/

# Debian build artifacts
debian/cargo-home/
debian/podup/
debian/debhelper-build-stamp
debian/files
debian/*.substvars
debian/*.log

# Host-specific benchmark output (published numbers live in README)
bench/results/

# Local tooling scratch directories. A global gitignore and .git/info/exclude
# cover them on the maintainer's machine, but neither travels with the repo, so
# on a fresh clone or on CI they were unprotected: a single `git add -A` would
# publish them. Listing them here keeps them out of the tree for everyone.
.claude/
.superpowers/
.playwright-mcp/
/bench/timeit/target
